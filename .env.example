# Required: Bearer credential used by Custom GPT -> this service.
API_TOKEN=replace-with-a-long-random-secret

# Keep the origin private; publish it through Cloudflare Tunnel.
LISTEN_ADDR=127.0.0.1:8787

# Universal root-shell execution limits. MAX_COMMAND_OUTPUT_CHARS controls only
# the rolling inline stdout/stderr preview; large complete output is returned as
# GPT Action file attachments instead of trying to exceed the Action JSON limit.
COMMAND_TIMEOUT_SECONDS=86400
MAX_COMMAND_OUTPUT_CHARS=180000

# Any additional variables placed in the systemd EnvironmentFile are inherited
# by runCommand child processes. Keep secrets on the VPS rather than in GPT
# instructions. Examples may include provider tokens or non-secret defaults, but
# the agent itself has no provider-specific configuration or allowlist.
